# Database (Docker)
DATABASE_URL="postgresql://trading_user:trading_password@localhost:5432/trading_analytics?schema=public"

# For connecting from inside Docker container (if you dockerize the backend later)
# DATABASE_URL="postgresql://trading_user:trading_password@postgres:5432/trading_analytics?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Redis (optional - for caching)
REDIS_URL="redis://localhost:6379"
REDIS_ENABLED="false"

# Server
PORT=5000
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:5173"

# Cache TTL (in seconds)
CACHE_TTL=3600

# MT5 Integration
MT5_ENCRYPTION_KEY="your-mt5-encryption-key-32chars"

# Database Credentials (used by Docker Compose)
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=trading_password
POSTGRES_DB=trading_analytics
